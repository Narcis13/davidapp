{
  "ref": "sketch-code@3",
  "type": "function",
  "kind": "visual",
  "title": "Sketched code card",
  "description": "A hand-drawn card with code typing itself in: the card draws on with a wobbly ink outline and a hard offset shadow, a header with three marker dots and a file name, then each line types in a mono face with keywords and calls in the accent and comments muted (colours that stay readable on the card), a caret at the end. One line can be swiped with a highlighter at its time. Sizes are a share of the frame's short side with a floor. For doodle and whiteboard explainers of code.",
  "tags": ["sketch", "hand-drawn", "doodle", "code", "typing", "card", "explainer", "scene"],
  "duration": 8,
  "formats": ["vertical", "horizontal", "square"],
  "schema": {
    "lines": {
      "type": "array",
      "of": {"type": "string", "default": ""},
      "minItems": 1,
      "maxItems": 14,
      "default": ["render(f) {", "  const k = f.t / f.duration;", "  draw(f.ctx, k);", "}"]
    },
    "file": {"type": "string", "default": "scene.js", "description": "File name in the header (empty: none)"},
    "theme": {"type": "asset", "kind": "value", "default": "theme-fablecut-doodle"},
    "size": {
      "type": "number",
      "default": 4.2,
      "min": 2.5,
      "max": 10,
      "step": 0.1,
      "description": "Code size, % of the frame's short side (shrinks to fit, never under the floor)"
    },
    "floor": {
      "type": "number",
      "default": 4,
      "min": 2,
      "max": 10,
      "step": 0.1,
      "description": "Smallest code size on screen, % of the frame's short side"
    },
    "delay": {
      "type": "number",
      "default": 0.2,
      "min": 0,
      "max": 30,
      "step": 0.05,
      "description": "Seconds before the card starts to draw"
    },
    "drawDur": {
      "type": "number",
      "default": 0.6,
      "min": 0.1,
      "max": 3,
      "step": 0.05,
      "description": "Seconds the card takes to draw on"
    },
    "cps": {
      "type": "number",
      "default": 32,
      "min": 4,
      "max": 200,
      "step": 1,
      "description": "Characters typed per second"
    },
    "linePause": {
      "type": "number",
      "default": 0.12,
      "min": 0,
      "max": 2,
      "step": 0.01,
