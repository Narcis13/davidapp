    },
    "tickStart": {"type": "number", "default": 1.2, "min": 0, "max": 60, "step": 0.05},
    "tickEvery": {"type": "number", "default": 0.6, "min": 0.05, "max": 10, "step": 0.05},
    "theme": {"type": "asset", "kind": "value", "default": "theme-fablecut-doodle"},
