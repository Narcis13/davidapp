# small screen recordings of the studio (scripts/record-studio.mjs) are source material for clips
!showcase/footage/*.mp4
!showcase/footage/*/*.mp4
# the content store clips are exported to (src/studio/exchange.js): files by SHA-256, whatever their type
!library/files/*
*.db
*.db-wal
*.db-shm
.env
.env.*
npm-debug.log*
/tmp/

# the deliverables of a clip (MP4, poster, captions, credits): they go on a release, not in git
work/*/out/

# the voice helper (tools/voice): its node_modules and the Kokoro model cache are never committed
tools/voice/cache/
