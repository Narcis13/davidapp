node_modules/
data/
output/
*.mp4
*.mov
*.webm
# small screen recordings of the studio (scripts/record-studio.mjs) are source material for clips
!showcase/footage/*.mp4
!showcase/footage/*/*.mp4
# the content store clips are exported to (src/studio/exchange.js): files by SHA-256, whatever their type
!library/files/*
*.db
*.db-wal
*.db-shm
.env
.env.*
npm-debug.log*
/tmp/

# the deliverables of a clip (MP4, poster, captions, credits): they go on a release, not in git
work/*/out/

# the voice helper (tools/voice): its node_modules and the Kokoro model cache are never committed
tools/voice/cache/

# media a clip's work leaves (stills, sheets, cut strips, voice samples): local only, rebuilt from the clip.
# Git holds the code and the asset store (library/); .claude/skills/new-video/scripts/check-no-media.mjs guards it.
work/**/*.png
work/**/*.jpg
work/**/*.jpeg
work/**/*.gif
work/**/*.webp
work/**/*.wav
work/**/*.mp3
work/**/*.m4a
work/**/*.ogg
work/**/*.flac
