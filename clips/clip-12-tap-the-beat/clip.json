    "theme": "theme-neon@1",
    "interactive": {
      "start": "title",
      "vars": {
        "score": 0,
        "combo": 0,
        "best": 0,
        "hits": 0,
        "perfects": 0,
        "strays": 0,
        "lane": 0,
        "help": false,
        "keys": true,
        "speed": 1
      },
      "scenes": [
        {"id": "title", "start": 0, "duration": 4, "end": "hold", "label": "Title"},
        {"id": "game", "start": 4, "duration": 28.5, "end": "next", "label": "Song"},
        {"id": "results", "start": 32.5, "duration": 3, "end": "hold", "label": "Results", "final": true}
      ],
      "wires": [
        {
          "on": "play.press",
          "do": [
            {"play": "click"},
            {"set": {"score": 0, "combo": 0, "best": 0, "hits": 0, "perfects": 0, "strays": 0}},
            {"go": "game"}
          ]
        },
        {
          "on": "how.press",
          "do": [{"play": "click"}, {"set": {"help": true}}, {"send": "help", "event": "open"}]
        },
        {"on": "help.confirm", "do": [{"play": "click"}, {"set": {"help": false}}]},
        {"on": "help.cancel", "do": [{"set": {"help": false}}]},
        {"on": "keys.change", "do": [{"play": "click"}, {"set": {"keys": "$value"}}]},
        {"on": "speed.change", "do": [{"set": {"speed": "$value"}}]},
        {
          "on": "field.perfect",
          "do": [
            {"set": {"combo": "$value.combo", "lane": "$value.lane"}},
            {"add": {"score": 100, "hits": 1, "perfects": 1}},
            {"add": {"score": {"$var": "combo"}}},
            {"if": {"var": "combo", "gt": {"$var": "best"}}, "then": [{"set": {"best": {"$var": "combo"}}}]},
            {"if": {"var": "lane", "eq": 0}, "then": [{"play": "hit-0"}]},
            {"if": {"var": "lane", "eq": 1}, "then": [{"play": "hit-1"}]},
            {"if": {"var": "lane", "eq": 2}, "then": [{"play": "hit-2"}]},
            {"if": {"var": "lane", "eq": 3}, "then": [{"play": "hit-3"}]},
            {
              "if": {"var": "combo", "eq": 10},
              "then": [{"send": "toast", "event": "success", "value": "10 in a row"}, {"send": "score", "event": "bump"}]
            },
            {
              "if": {"var": "combo", "eq": 25},
              "then": [{"send": "toast", "event": "success", "value": "25 in a row"}, {"send": "score", "event": "bump"}]
            },
            {
              "if": {"var": "combo", "eq": 40},
              "then": [{"send": "toast", "event": "success", "value": "40 in a row"}, {"send": "score", "event": "bump"}]
            }
          ]
        },
        {
          "on": "field.good",
          "do": [
            {"set": {"combo": "$value.combo", "lane": "$value.lane"}},
            {"add": {"score": 50, "hits": 1}},
            {"add": {"score": {"$var": "combo"}}},
            {"if": {"var": "combo", "gt": {"$var": "best"}}, "then": [{"set": {"best": {"$var": "combo"}}}]},
            {"if": {"var": "lane", "eq": 0}, "then": [{"play": "hit-0"}]},
            {"if": {"var": "lane", "eq": 1}, "then": [{"play": "hit-1"}]},
            {"if": {"var": "lane", "eq": 2}, "then": [{"play": "hit-2"}]},
            {"if": {"var": "lane", "eq": 3}, "then": [{"play": "hit-3"}]},
            {
              "if": {"var": "combo", "eq": 10},
              "then": [{"send": "toast", "event": "success", "value": "10 in a row"}, {"send": "score", "event": "bump"}]
            },
            {
              "if": {"var": "combo", "eq": 25},
              "then": [{"send": "toast", "event": "success", "value": "25 in a row"}, {"send": "score", "event": "bump"}]
            },
            {
              "if": {"var": "combo", "eq": 40},
              "then": [{"send": "toast", "event": "success", "value": "40 in a row"}, {"send": "score", "event": "bump"}]
            }
          ]
        },
        {"on": "field.miss", "do": [{"set": {"combo": 0}}, {"add": {"strays": 1}}, {"play": "miss"}]},
        {
          "on": "again.press",
          "do": [
            {"play": "click"},
            {"set": {"score": 0, "combo": 0, "best": 0, "hits": 0, "perfects": 0, "strays": 0}},
            {"go": "game"}
          ]
        },
        {"on": "menu.press", "do": [{"play": "click"}, {"go": "title"}]}
      ],
      "transition": {"asset": "ui-tx-iris@1", "params": {"zoom": 0, "dim": 0}, "duration": 0.6}
    }
  },
