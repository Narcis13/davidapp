            "start": 4,
            "duration": 28.5,
            "params": {"value": {"$var": "score"}, "label": "Score", "icon": "zap", "theme": "theme-neon@1"},
            "transform": {"x": 0.5, "y": 0.09, "width": 0.6, "height": 0.08}
          },
          {
            "id": "toast",
            "asset": "ui-toast@1",
            "start": 4,
            "duration": 28.5,
            "params": {"edge": "center", "hold": 1.2, "theme": "theme-neon@1"},
            "transform": {"x": 0.5, "y": 0.35, "width": 0.9, "height": 0.12}
          },
          {
            "id": "help",
            "asset": "ui-dialog@1",
            "start": 0,
            "duration": 4,
            "params": {
              "title": "How to play",
              "icon": "music",
              "confirm": "Got it",
              "cancel": "",
              "tone": "accent",
              "theme": "theme-neon@1",
              "body": "Notes ride down four lanes. Tap a lane, or press D F J K (or the arrows), as its note crosses the line.\nRight on the beat is perfect; a tap on an empty lane or a note let through ends the streak."
            },
            "when": {"var": "help", "eq": true}
          }
        ]
      },
      {
        "id": "music",
        "name": "Music",
        "type": "audio",
