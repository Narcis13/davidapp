//- Writing assets. Params: d.
div(data-ui="prose")
  raw p("You can make videos without writing code, from the assets the library already has. When you need something new, an asset is one JavaScript file that calls `asset({...})` once. You can write it in the [playground's source editor](/docs/playground#source), as a file in the `assets/` folder of the repository (then `npm run sync-assets`), or ask Claude to write it.")

  h2#example A first asset
  pre
    code
      | asset({
      |   title: 'Word reveal',
      |   description: 'Words rise into place one after another. For headlines.',
      |   tags: ['text', 'text-animation', 'reveal'],
      |   duration: 4,                         // its natural length; leave out for backgrounds and loops
      |   uses: ['easing'],                    // other assets it calls: pinned to a version on save
      |   params: {
      |     text:  { type: 'text', default: 'Every frame is a *function* of time' },
      |     size:  { type: 'number', default: 150, min: 12, max: 600 },
      |     color: { type: 'color', default: '#f4f1ea' },
      |   },
      |   render(f, p) {                       // draws the frame at time f.t with the values p
      |     const E = f.use('easing');
      |     const L = f.lib.text.layout(f.ctx, p.text, { font: 'Space Grotesk', weight: 700, size: p.size,
      |       maxWidth: f.safe.width, maxHeight: f.safe.height, fit: true, align: 'center', markup: true });
      |     const y = f.safe.y + (f.safe.height - L.height) / 2;
      |     for (const word of L.words) {
      |       const k = E.outExpo(f.lib.stagger(f.t, word.index, 0.08, 0.6));
      |       if (k <= 0) continue;
      |       f.ctx.globalAlpha = f.lib.clamp01(k * 2);
      |       f.ctx.fillStyle = p.color;
      |       f.lib.text.fillWord(f.ctx, word, f.safe.x, y + (1 - k) * 70);
      |     }
      |   },
      | });
  raw p("`asset()` takes only these keys: `kind`, `title`, `description` (required, at least 12 characters), `tags` (required, lowercase with dashes), `duration` (up to 600 s), `formats` (default: all three), `params`, `uses`, `render`, `preview` and `floor`. `uses` is a list (`['easing', 'lower-third@2']`) or a map of names (`{ base: 'lower-third@2' }`).")

  h2#rules The rules
  ol
    li
      raw md("**Pure.** A frame may depend only on the time `f.t`, the parameters and the seeded random numbers `f.rng`. Keep nothing between calls: the studio draws frames out of order and on several threads, and compares them.")
    li
      raw md("**Synchronous.** `render` returns when the frame is drawn. A frame that takes too long is stopped.")
    li
      raw md("**Responsive.** Lay out from `f.width`, `f.height`, `f.vmin` and `f.safe`, never from fixed pixel positions, so the asset works in every format.")
    li
      raw md("**Balanced.** Pair every `ctx.save()` with a `ctx.restore()`.")
    li
      raw md("**Declared.** `f.use('x')` works only if `x` is in `uses` (or arrived through a parameter of type `asset`). That is how the studio pins versions.")
  +callout(variant="warning")
    @content
      raw p("**Refused when you save:** `Math.random`, `Date.now`, `new Date()`, `performance.now`, `setTimeout`, `setInterval`, `requestAnimationFrame`, `queueMicrotask`, `import`, `require`, `fetch`, `XMLHttpRequest`, `WebSocket`, `process.`, `globalThis.`, `window.`, `document.`, `eval(`, `new Function`, `async` and `await`, and a source with no `asset(` call or over 200,000 characters. Comments and strings are not checked. Use `f.rng` for randomness.")
  raw p("Saving runs the asset in a sandbox, draws test frames in every format it supports, checks that the same frame drawn twice is the same, and only then stores it as a new version. A broken asset is refused with the reason and, where possible, the line.")

  h2#frame The frame object f
  div(role="region" aria-label="The frame object" tabindex="0")
    table
      thead
        tr
          th Field
          th What it holds
      tbody
        tr
          td
            raw md("`f.ctx`")
          td A Canvas 2D context. Its origin is the top-left corner of the asset's box.
        tr
          td
            raw md("`f.t`, `f.duration`, `f.progress`")
          td
            raw md("The time in seconds since the item started, the length it was given, and `t / duration` between 0 and 1.")
        tr
          td
            raw md("`f.frame`, `f.fps`")
          td The frame number and the clip's frame rate.
        tr
          td
            raw md("`f.width`, `f.height`, `f.vmin`, `f.vmax`, `f.aspect`, `f.format`")
          td
            raw md("The box the asset draws in. `f.vmin` is 1 % of the shorter side: use it for sizes.")
        tr
          td
            raw md("`f.safe`")
          td
            raw md("`{ x, y, width, height, top, right, bottom, left }`: the area clear of platform buttons. Keep text inside it.")
        tr
          td
            raw md("`f.rng`, `f.seed`")
          td
            raw md("Seeded random numbers: `f.rng()`, `.range(a, b)`, `.int(a, b)`, `.pick(list)`, `.bool(p)`, `.gauss()`, `.shuffle(list)`, `.fork(key)`. The sequence restarts every frame, so the n-th call always returns the same number.")
        tr
          td
            raw md("`f.clip`")
          td
            raw md("The clip around the asset: `t`, `frame`, `duration`, `fps`, `width`, `height`, `format`, `beats` (seconds found in the music), `markers`, and with a narration `words`, `captions` and `lane` (the caption band).")
        tr
          td
            raw md("`f.theme`")
          td
            raw md("The clip's theme value, or `null`. Default to it: `f.theme?.accent ?? p.color`.")
        tr
          td
            raw md("`f.use(name, params, opts)`")
          td
            raw md("Draw another asset in a box and a time window (`{ x, y, width, height, at, duration, hold, alpha }`), or get a value asset's value.")
        tr
          td
            raw md("`f.image(name)`, `f.svg(name)`")
          td
            raw md("An uploaded picture for `ctx.drawImage`; the vector drawing of an uploaded SVG, to draw on stroke by stroke or recolour.")
        tr
          td
            raw md("`f.offscreen(w, h)`, `f.layers(list, values)`")
          td A scratch layer for masks and group effects; clip-style layers drawn inside the asset (a precomp).
        tr
          td
            raw md("`f.lib`")
          td The standard library, below.

  h2#lib The standard library f.lib
  dl
    dt math
    dd
      raw md("`clamp`, `clamp01`, `lerp`, `invLerp`, `remap`, `smoothstep`, `phase(t, start, dur)`, `stagger(t, i, each, dur, start)`, `envelope(t, duration, inDur, outDur)`, `fract`, `mod`, `pingpong`, `deg`, `dist`, `TAU`.")
    dt color
    dd
      raw md("`parse`, `css`, `mix(a, b, t)`, `alpha(color, a)`, `lighten`, `darken`, `hsl`, `luminance`, `onColor(bg)` (a readable ink for a background).")
    dt text
    dd
      raw md("`layout(ctx, text, opts)` lays text out in lines, words and glyphs with `font`, `weight`, `size`, `maxWidth`, `maxHeight`, `maxLines`, `align`, `fit` (shrink to the box), `markup` (`*emphasis*`), `letterSpacing` and more; draw it with `fill`, `fillLine`, `fillWord`, `fillGlyph`, `strokeWord`. Text drawn this way is **measured** by the checks; text drawn with a raw `ctx.fillText` is not.")
    dt beat, noise
    dd
      raw md("`beat.at`, `beat.pulse`, `beat.count` on the clip's beats; `noise(seed)(x, y, z)` and `fbm` in −1..1.")
    dt audio
    dd
      raw md("For sound assets: `buffer`, `tone`, `noiseBurst`, `mix`, `lowpass`, `highpass`, `delay`, `fade`, `softclip`, `normalize`, `gain`, `midi`, `adsr`.")
    dt fx
    dd
      raw md("Pixel helpers for effects: `read`, `write`, `blur`, `glow`, `grain`, `vignette`, `grade`, `duotone`, `chromatic`, `displace`, `pixelate`, `scanlines`, `over` and more. Use these, not `ctx.filter`, so the browser and the renderer agree.")
    dt solid
    dd
      raw md("A software 3D renderer: meshes (box, sphere, torus, lathe, extrusion, terrain, block text), a camera, lights, flat, smooth and toon shading, fog. 3D is slow at full size: bake it into a sequence ([Pictures, video and fonts](/docs/media#sequences)).")
    dt svg
    dd
      raw md("`parsePath`, `flatten`, `pathLength`, `draw`: what `f.svg(name).draw` is built on.")

  h2#text-floor Text that cannot fail silently
  raw p("Give text a **floor**, the smallest size it may reach on screen, as a percentage of the frame's short side: `floor: 2.6` on the asset, or `floor` in a layout. `fit` shrinks text only down to the floor. A text that still does not fit stops with a clear error naming the item and the time, instead of being cut off or getting an ellipsis. Text marked `role: 'ticker'` (meant to scroll past) is not held to reading time by the checks.")

  h2#params Parameter types
  div(role="region" aria-label="Parameter types" tabindex="0")
    table
      thead
        tr
          th Type
          th Options
          th The control in the studio
      tbody
        tr
          td
            raw md("`number`, `integer`")
          td
            raw md("`min`, `max`, `step`, `unit`")
          td Slider and number box
        tr
          td
            raw md("`boolean`")
          td
          td Switch
        tr
          td
            raw md("`string`, `text`")
          td
            raw md("`maxLength`, `placeholder` (`text` is several lines)")
          td Text box
        tr
          td
            raw md("`enum`")
          td
            raw md("`options`: a list of strings")
          td Menu
        tr
          td
            raw md("`color`")
          td
          td
            raw md("Colour picker (hex, `rgb()`, `hsl()` or `transparent`)")
        tr
          td
            raw md("`font`")
          td
          td A family: bundled, or added to the library
        tr
          td
            raw md("`image`")
          td
          td An image asset, or footage
        tr
          td
            raw md("`asset`")
          td
            raw md("`kind`, `tag` narrow the choice")
          td Another asset
        tr
          td
            raw md("`array`, `object`")
          td
            raw md("`of`, `minItems`, `maxItems`; `fields`")
          td A list or a group of controls
  raw p("Every parameter may also have a `label`, a `description` and a `group`. Parameter names are letters, digits and underscores. When a clip is saved, a value outside `min`–`max` is an error.")

  h2#kinds The other kinds
  dl
    dt value
    dd
      raw md("`render` returns a value (a palette, a table of easing functions). Add `preview(f, p)` to draw its thumbnail. A **theme** is a value asset returning `{ bg, bgAlt, surface, ink, muted, accent, accent2, accent3, fonts, motion }`.")
    dt audio
    dd
      raw md("`render` returns samples: a `Float32Array` (mono) or `{ left, right }` of `f.duration × f.sampleRate` samples.")
    dt motion
    dd
      raw md("`render` returns a change to the item's transform, `{ x, y, scale, scaleX, scaleY, rotation, opacity }`, for `f.phase` (`in`, `out`, `emphasis`, `loop`). Return to rest at the end of `in` and the start of `out`, or the item jumps.")
    dt transition
    dd
      raw md("Draws `f.from` turning into `f.to` over `f.progress`. At progress 1 the result should be `f.to`.")
    dt effect
    dd
      raw md("Draws a processed copy of `f.source` with the `f.lib.fx` helpers. Scale radii with `f.vmin`.")
  raw p("Motions, transitions and effects are previewed on a demo scene in the playground. Every kind is saved, versioned and pinned the same way.")

  h2#presets Presets and precomps: assets without code
  ul
    li
      raw md("A **preset** is an asset plus your parameter values as its defaults. Make one in the playground (**Save as preset**) or with `create_preset`.")
    li
      raw md("A **precomp** is several clip layers drawn as one asset, with chosen parameters exposed. Make one in the clip editor (**Save as asset**) or with `save_precomp`.")

  h2#naming Names and conventions
  ul
    li
      raw md("Name by family, so searches group them: `text-*`, `bg-*`, `motion-*`, `trans-*`, `fx-*`, `mask-*`, `theme-*`, `*-3d`, `kit-*`.")
    li Write a description that says what it looks like and when to use it: the search weighs names, titles, tags and descriptions.
    li
      raw md("Read the clip's theme for colours and fonts, so the asset matches any clip it is put in.")
    li
      raw md("Every asset in the repository's `assets/` folder is a worked example; `name.v2.js` is version 2 of `name`. The complete contract is in `docs/ASSET_CONTRACT.md`, and recipes for the tools in `docs/COOKBOOK.md`.")
